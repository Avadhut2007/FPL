{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["templates/**", "static/**", "config.py", "fpl_api.py", "data_processor.py", "predictor.py", "optimizer.py", "app.py"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
